<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#222222">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Pengaturan AdTurbo v4"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Speedhack Checkbox & SeekBar -->
        <CheckBox
            android:id="@+id/chkSpeedhack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktifkan Speedhack Game"
            android:textColor="#FFFFFF"
            android:checked="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kecepatan Waktu (Speed Multiplier):"
            android:textColor="#CCCCCC"
            android:layout_marginTop="8dp"/>

        <SeekBar
            android:id="@+id/seekBarSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="20" />

        <!-- Auto Ad-Skip -->
        <CheckBox
            android:id="@+id/chkAdSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Otomatis Skip / Fast Forward Iklan"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginTop="12dp" />

        <!-- Auto Clicker / Bypass Timer -->
        <CheckBox
            android:id="@+id/chkAutoBypass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bypass Delay / Auto-Click Countdown"
            android:textColor="#FFFFFF"
            android:checked="true"
            android:layout_marginTop="8dp" />

        <!-- Tombol RELOAD -->
        <Button
            android:id="@+id/btnReload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 RELOAD HALAMAN"
            android:backgroundTint="#0088FF"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
